# qura-client-server runtime env. bootstrap.sh renders it to $QURA_ROOT/env/client-server.env
# (secret placeholders are filled with random hex, DB passwords from postgres.env). Edit the rendered
# file on the server for real keys, then: scripts/deploy.sh client-server --force
QURA_ENVIRONMENT=production
QURA_APP_NAME=Qura Client Portal API
QURA_API_PREFIX=/api/client
QURA_HOST=0.0.0.0
QURA_PORT=8787
QURA_DATABASE_URL=postgresql+asyncpg://qura_client:__PG_QURA_CLIENT_DB_PASSWORD__@postgres:5432/qura_client
QURA_DATABASE_NAME_PREFIX=qura_
QURA_DATABASE_POOL_SIZE=5
QURA_DATABASE_MAX_OVERFLOW=5
QURA_SESSION_SECRET=__SECRET__
# Unset = no CORS: the SPA reaches the API same-origin through a Vercel rewrite.
# (An empty value fails to parse; to enable, use a JSON list: ["https://app.example.com"])
# QURA_CORS_ALLOW_ORIGINS=
QURA_LOG_LEVEL=INFO
QURA_LOG_JSON=true
QURA_STORAGE_DIR=/data/storage
QURA_UPLOAD_MAX_BYTES=15728640
# Optional AI policy extraction; empty = extraction reported unavailable.
QURA_OPENAI_API_KEY=
QURA_OPENAI_API_BASE=https://api.openai.com/v1
QURA_OPENAI_MODEL_NAME=gpt-4.1
QURA_OPENAI_TIMEOUT_SECONDS=60

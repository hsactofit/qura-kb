# Qura-crm-server runtime env. Rendered by bootstrap.sh to $QURA_ROOT/env/crm-server.env.
# Fill R2 / OpenAI / Smartflo on the server, then: scripts/deploy.sh crm-server --force
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://qura_crm:__PG_QURA_CRM_DB_PASSWORD__@postgres:5432/qura_crm?schema=public&connection_limit=10
DB_POOL_SIZE=10
JWT_SECRET=__SECRET__
# CRM panel origin(s), comma-separated (the panel proxies same-origin, so this is a fallback).
CORS_ORIGINS=http://localhost:3000
# Cloudflare R2 (policy/claim uploads). Empty = uploads report "storage not configured".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SMARTFLO_API_BASE_URL=
SMARTFLO_API_TOKEN=
SMARTFLO_WEBHOOK_SECRET=

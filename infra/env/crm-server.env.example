# Qura-crm-server runtime env. Rendered by bootstrap.sh to $QURA_ROOT/env/crm-server.env.
# Fill R2 / OpenAI / Smartflo on the server, then: scripts/deploy.sh crm-server --force
NODE_ENV=production
PORT=4000
# Shared product database; the CRM owns the `crm` schema and reads the `client` schema.
DATABASE_URL=postgresql://qura_crm:__PG_QURA_CRM_DB_PASSWORD__@postgres:5432/qura_main?schema=crm&connection_limit=10
DB_POOL_SIZE=10
JWT_SECRET=__SECRET__
# CRM panel origin(s), comma-separated (the panel proxies same-origin, so this is a fallback).
CORS_ORIGINS=http://localhost:3000
# Service-to-service token shared with client-server (internal endpoints, Docker network only).
INTERNAL_API_TOKEN=__SHARED_QURA_INTERNAL_TOKEN__
# How often (seconds) portal sign-ups, uploads and requests are pulled into the CRM.
CLIENT_SYNC_INTERVAL_SECONDS=10
# Minutes between renewal-reminder passes (tasks for policies expiring this month / within 30 days); 0 = off.
RENEWAL_REMINDER_INTERVAL_MINUTES=60
# Cloudflare R2 for documents. Empty = files are kept on the server's crm_storage volume
# (backed up nightly). Fill all four to store new uploads in R2 instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_INVOICES_BUCKET_NAME=
# OpenAI reads policy PDFs (policy number, insurer, dates, cover, members, benefits, exclusions...).
# Empty = basic text rules only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Smartflo click-to-call. Empty = calls are logged for manual dialing.
SMARTFLO_API_BASE_URL=
SMARTFLO_API_TOKEN=
SMARTFLO_WEBHOOK_SECRET=

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed to /Library/LaunchDaemons by bootstrap.sh: runs at boot, before any login. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.qura.boot</string>
  <key>UserName</key><string>__USER__</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__QURA_INFRA__/scripts/boot.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>QURA_ROOT</key><string>__QURA_ROOT__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Colima's VM must outlive this short-lived job. -->
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>__QURA_ROOT__/logs/launchd-boot.log</string>
  <key>StandardErrorPath</key><string>__QURA_ROOT__/logs/launchd-boot.log</string>
</dict>
</plist>

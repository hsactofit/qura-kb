<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly 02:30 database + upload-volume backups. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.qura.backup</string>
  <key>UserName</key><string>__USER__</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__QURA_INFRA__/scripts/backup.sh</string><string>daily</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>QURA_ROOT</key><string>__QURA_ROOT__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>__QURA_ROOT__/logs/launchd-backup.err</string>
</dict>
</plist>
